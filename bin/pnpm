#!/usr/bin/env sh
# Project-local pnpm. Node 26 no longer ships corepack, so pnpm is installed
# under .tools/ (gitignored) at the version pinned in package.json.
set -e
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
version=$(node -p "require('$root/package.json').packageManager.split('@')[1]")
bin="$root/.tools/node_modules/.bin/pnpm"
if [ ! -x "$bin" ] || [ "$("$bin" -v 2>/dev/null)" != "$version" ]; then
  npm install --prefix "$root/.tools" --no-save --no-package-lock "pnpm@$version" >/dev/null
fi
PATH="$root/.tools/node_modules/.bin:$PATH"
export PATH
exec "$bin" "$@"
